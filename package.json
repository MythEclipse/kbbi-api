{
  "name": "kbbi-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted KBBI (Indonesian dictionary) REST API — 112,645 words, zero runtime dependencies.",
  "license": "MIT",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch run src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "prepare-data": "bun run scripts/prepare-data.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}